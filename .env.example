# Firebase Environment Variables Template
# Copy this file to .env and fill in your real values
# The .env file is gitignored and will NEVER be committed to GitHub

VITE_FB_API_KEY=your_api_key_here
VITE_FB_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FB_PROJECT_ID=your_project_id
VITE_FB_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FB_APP_ID=your_app_id

# Your company identifier in Firestore (lowercase, no spaces)
VITE_FB_COMPANY_ID=newlanka

# Customer feature toggles (true/false)
VITE_FEATURE_DASHBOARD=true
VITE_FEATURE_CADER=true
VITE_FEATURE_JOBDESK=true
VITE_FEATURE_EMPLOYEES=true
VITE_FEATURE_LEAVE=true
VITE_FEATURE_ATTENDANCE=true
VITE_FEATURE_PAYROLL=true
VITE_FEATURE_ADMIN=true
VITE_FEATURE_SETTINGS=true
VITE_FEATURE_BACKUP=true
VITE_FEATURE_AUDIT=true
VITE_FEATURE_ABOUT=true
VITE_FEATURE_TERMS=true
